NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
ADMIN_EMAILS=you@email.com
# Second admin: students only (no universities, matching)
ADMIN_LIMITED_EMAILS=associate@email.com
RESEND_API_KEY=
# Obligatoire en production : sans ce secret, les webhooks Resend sont rejetés.
RESEND_WEBHOOK_SECRET=
RESEND_INBOUND_EMAIL=contact@chinoisendevenir.com
MAMMOUTH_API_KEY=
MAMMOUTH_MODEL=minimax-m3
# Modèle des e-mails admin (Mammouth). gpt-4.1-mini rédige mieux que nano.
MAMMOUTH_COMPOSE_MODEL=gpt-4.1-mini
# Blog IA (optionnel). Sinon : gpt-4.1 puis fallback compose.
MAMMOUTH_BLOG_MODEL=

# Relance automatique des formules (cron Vercel, tous les jours à 10h Pékin)
# Vercel envoie Authorization: Bearer CRON_SECRET
CRON_SECRET=

# OpenWA (https://github.com/rmyndharis/OpenWA) — WhatsApp sur la fiche étudiant, admin full.
# Docker local : http://localhost:2785 (sans /api). La session doit déjà être connectée (QR scanné).
OPENWA_BASE_URL=http://localhost:2785
OPENWA_API_KEY=
OPENWA_SESSION_ID=

# Airwallex — laisser vide tant que le compte n'existe pas.
# Sans CLIENT_ID + API_KEY, le bouton Payer explique que le paiement n'est pas configuré.
# Aucun paiement n'est simulé.
AIRWALLEX_CLIENT_ID=
AIRWALLEX_API_KEY=
# Secret de l'URL de notification (Developer > Webhooks). Sans lui, POST /api/webhooks/airwallex est rejeté.
AIRWALLEX_WEBHOOK_SECRET=
# demo (sandbox, défaut) ou prod.
# demo → https://api-demo.airwallex.com ; prod → https://api.airwallex.com
# Le quickstart cite aussi https://api.sandbox.airwallex.com : le poser dans AIRWALLEX_API_BASE si besoin.
AIRWALLEX_ENV=demo
AIRWALLEX_API_BASE=
