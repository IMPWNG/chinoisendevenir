NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
ADMIN_EMAILS=you@email.com,associate@email.com
RESEND_API_KEY=
# Obligatoire en production : sans ce secret, les webhooks Resend sont rejetés.
RESEND_WEBHOOK_SECRET=
RESEND_INBOUND_EMAIL=contact@chinoisendevenir.com
MAMMOUTH_API_KEY=
MAMMOUTH_MODEL=minimax-m3
# Modèle des e-mails admin (Mammouth). gpt-4.1-nano est plus naturel que MiniMax.
MAMMOUTH_COMPOSE_MODEL=gpt-4.1-nano

# WhatsApp Cloud API (Meta)
# https://developers.facebook.com/docs/whatsapp/cloud-api/get-started
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
# Obligatoire : sans ce secret, les webhooks WhatsApp sont rejetés.
WHATSAPP_APP_SECRET=
WHATSAPP_API_VERSION=v21.0
# Pour les premiers messages (hors fenêtre 24h), créez des modèles dans Meta Business Manager
WHATSAPP_USE_TEMPLATES=false
WHATSAPP_TEMPLATE_LANGUAGE=fr
WHATSAPP_TEMPLATE_RELANCE_1=
WHATSAPP_TEMPLATE_RELANCE_2=
WHATSAPP_TEMPLATE_FORMULES=
WHATSAPP_TEMPLATE_FORMULE_CONFIRMEE=
