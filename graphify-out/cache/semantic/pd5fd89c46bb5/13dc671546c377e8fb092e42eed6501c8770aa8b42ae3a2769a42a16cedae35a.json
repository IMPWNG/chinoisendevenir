{"nodes": [{"id": "_agents_skills_supabase_postgres_best_practices_references_security_rls_performance_select_wrapper", "label": "Wrap RLS Functions in SELECT", "file_type": "rationale", "source_file": ".agents/skills/supabase-postgres-best-practices/references/security-rls-performance.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "auth.uid() in a policy is invoked per row; wrapping as (select auth.uid()) caches the result once and can be 100x+ faster on large tables."}, {"id": "_agents_skills_supabase_postgres_best_practices_references_security_rls_performance_security_definer", "label": "SECURITY DEFINER Helper Functions", "file_type": "rationale", "source_file": ".agents/skills/supabase-postgres-best-practices/references/security-rls-performance.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "SECURITY DEFINER bypasses RLS on tables it touches; always check auth.uid() inside, keep functions in a private schema, and revoke EXECUTE from PUBLIC/anon/authenticated/service_role."}, {"id": "_agents_skills_supabase_postgres_best_practices_references_security_rls_performance_rls_column_indexes", "label": "Indexes on RLS Policy Columns", "file_type": "concept", "source_file": ".agents/skills/supabase-postgres-best-practices/references/security-rls-performance.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Always index columns used in RLS policies so policy checks use index scans."}], "edges": [{"source": "_agents_skills_supabase_postgres_best_practices_references_security_rls_performance_select_wrapper", "target": "_agents_skills_supabase_postgres_best_practices_references_security_rls_basics_auth_uid", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".agents/skills/supabase-postgres-best-practices/references