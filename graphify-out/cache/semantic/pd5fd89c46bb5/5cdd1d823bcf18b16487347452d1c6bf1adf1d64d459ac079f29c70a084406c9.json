{"nodes": [{"id": "_agents_skills_supabase_postgres_best_practices_references_schema_primary_keys_identity_columns", "label": "IDENTITY Primary Keys", "file_type": "rationale", "source_file": ".agents/skills/supabase-postgres-best-practices/references/schema-primary-keys.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "bigint IDENTITY is SQL-standard and preferred over serial for single-database sequential IDs; better index locality and replication."}, {"id": "_agents_skills_supabase_postgres_best_practices_references_schema_primary_keys_uuidv7", "label": "UUIDv7 Primary Keys", "file_type": "concept", "source_file": ".agents/skills/supabase-postgres-best-practices/references/schema-primary-keys.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Time-ordered UUIDs avoid B-tree fragmentation in distributed systems; requires pg_uuidv7. ULID is an alternative without an extension."}, {"id": "_agents_skills_supabase_postgres_best_practices_references_schema_primary_keys_uuidv4_fragmentation", "label": "UUIDv4 Index Fragmentation", "file_type": "rationale", "source_file": ".agents/skills/supabase-postgres-best-practices/references/schema-primary-keys.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Random UUIDv4 primary keys scatter inserts and fragment indexes on large tables."}], "edges": [{"source": "_agents_skills_supabase_postgres_best_practices_references_schema_primary_keys_uuidv4_fragmentation", "target": "_agents_skills_supabase_postgres_best_practices_references_schema_primary_keys_identity_columns", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".agents/skills/supabase-postgres-best-practices/references/schema-primary-keys.md", "source_location": null, "weight": 1.0}, {"source": "_agents_skills_supa