{"nodes": [{"id": "_agents_skills_supabase_postgres_best_practices_references_query_index_types_choose_right_index_type", "label": "Choose the Right Index Type", "file_type": "rationale", "source_file": ".agents/skills/supabase-postgres-best-practices/references/query-index-types.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Different index types excel at different query patterns; the default B-tree is not always optimal and can force sequential scans for operators it does not support."}, {"id": "_agents_skills_supabase_postgres_best_practices_references_query_index_types_btree", "label": "B-tree Index", "file_type": "concept", "source_file": ".agents/skills/supabase-postgres-best-practices/references/query-index-types.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Default index for equality, range, BETWEEN, IN, and IS NULL; cannot optimize JSONB containment operators such as @>."}, {"id": "_agents_skills_supabase_postgres_best_practices_references_query_index_types_gin", "label": "GIN Index", "file_type": "concept", "source_file": ".agents/skills/supabase-postgres-best-practices/references/query-index-types.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Use for arrays, JSONB, and full-text search; supports @>, ?, ?&, and ?|."}, {"id": "_agents_skills_supabase_postgres_best_practices_references_query_index_types_gist", "label": "GiST Index", "file_type": "concept", "source_file": ".agents/skills/supabase-postgres-best-practices/references/query-index-types.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Use for geometric data, range types, and nearest-neighbor (KNN) queries."}, {"id": "_agents_skills_supabase_postgres_best_practices_references_query_index_types_brin", "label": "BRIN Index", "file_type": "concept", "source_file": ".agents/skills/supabase-postgres-best-practices/references/query-index-types.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Use on large time-series tables; typically 10-100x smaller than B-tree."}, {"id": "_agents_skills_supabase_postgres_best_practices_references_query_index_types_hash", "label": "Hash Index", "file_type": "concept", "source_file": ".agents/skills/supabase-postgres-best-practices/references/query-index-types.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Equality-only lookups; slightly faster than B-tree for =."}, {"id": "_agents_skills_supabase_postgres_best_practices_references_query_index_types_postgresql_index_types", "label": "PostgreSQL Index Types Documentation", "file_type": "document", "source_file": ".agents/skills/supabase-postgres-best-practices/references/query-index-types.md", "source_location": null, "source_url": "https://www.postgresql.org/docs/current/indexes-types.html", "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "_agents_skills_supabase_postgres_best_practices_references_query_index_types_choose_right_index_type", "target": "_agents_skills_supabase_postgres_best_practices_references_query_index_types_btree", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".agents/skills/supabase-postgres-best-practices/references/query-index-types.md", "source_location": null, "weight": 1.0}, {"source": "_agents_skills_supabase_postgres_best_practices_references_query_index_types_choose_right_index_type", "target": "_agents_skills_supabase_postgres_best_practices_references_query_index_types_gin", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".agents/skills/supabase-postgres-best-practices/references/query-in