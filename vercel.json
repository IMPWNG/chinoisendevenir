{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "buildCommand": "npm run build",
  "crons": [
    {
      "path": "/api/cron/formules-relance",
      "schedule": "0 2 * * *"
    },
    {
      "path": "/api/cron/blog-generate",
      "schedule": "0 6 * * *"
    },
    {
      "path": "/api/cron/daily-report",
      "schedule": "0 12 * * *"
    }
  ]
}
